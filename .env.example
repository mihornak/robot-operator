# ROBOT OPERATOR — environment
#
# EVERY VARIABLE HERE IS OPTIONAL. With zero keys the game is fully playable:
# the parser falls back to the local intent matcher, the robot speaks in
# captions instead of voice, and wishlist signups land in a file on disk.
# Keys buy quality, never access. That is a repo law (CLAUDE.md rule 8).
#
# Local dev: copy to `.env` at the repo root (`cp .env.example .env`).
# Railway:   do NOT commit a `.env` — set these in the service's Variables tab.

# ---------------------------------------------------------------------------
# LLM — natural-language command parsing (/api/parse, /api/say)
# ---------------------------------------------------------------------------
# Without it: server/src/localParse.ts handles every utterance. Plain commands
# ("go to the door", "shoot it") still work; oblique phrasing gets misread more
# often and the robot's improvised lines fall back to the canned bank.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# TTS — the robot's voice (/api/tts)
# ---------------------------------------------------------------------------
# Without it: /api/tts returns an error and the client shows captions only.
# Nothing breaks; the robot just stops talking out loud.
ELEVENLABS_API_KEY=

# Which ElevenLabs voice to synthesise with. Written here by
# `node scripts/pickVoice.mjs`. Without it: a hardcoded default voice is used,
# so audio still plays — it is simply not the voice that was cast for the part.
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# Database — wishlist signups (/api/wishlist)
# ---------------------------------------------------------------------------
# Postgres connection string. The table is created on first write, so there is
# no migration step. Without it: signups are appended to
# server/logs/wishlist-YYYYMMDD.jsonl and the player still sees success — but
# on Railway that file lives on ephemeral disk and is DESTROYED on every
# redeploy. If you care about the emails, set this.
# On Railway, set it to the reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ---------------------------------------------------------------------------
# Analytics dashboard (/admin)
# ---------------------------------------------------------------------------
# Shared secret for the read-only ops dashboard and the /api/admin/* routes.
# Sent as `Authorization: Bearer <token>`, never as a query param. Generate one
# with: openssl rand -hex 32
# WITHOUT IT the entire admin surface answers 501 and the dashboard is off —
# deliberately, so a deploy that forgets this variable cannot be silently wide
# open. Needs DATABASE_URL too, or the routes answer 503.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the Hono server listens on. Defaults to 8790, so it is left commented
# out on purpose. NEVER set this on Railway: Railway injects PORT itself and
# uses the same value for the healthcheck, so a hardcoded one guarantees a
# failed deploy. It stays commented here so Railway's "import variables from
# .env.example" suggestion cannot pick it up by accident.
# PORT=8790
